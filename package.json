{
  "name": "scene-atlas",
  "version": "0.1.0",
  "description": "Scene Atlas — tabletop RPG scene manager with semantic search",
  "author": "jennis0 <joe.ennis18@gmail.com>",
  "main": "electron/dist/main.js",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "electron:dev": "concurrently --kill-others-on-fail \"cd frontend && npm run dev\" \"wait-on http://localhost:5173 && tsc -p electron/tsconfig.json && electron .\"",
    "electron:build": "tsc -p electron/tsconfig.json && electron-builder",
    "frontend:build": "cd frontend && npm install && npm run build",
    "test:electron": "node --test \"electron/test/*.test.ts\"",
    "test:e2e": "cd e2e && npx playwright test --project=chromium",
    "test:e2e:ui": "cd e2e && npx playwright test --ui",
    "test:e2e:headed": "cd e2e && npx playwright test --project=chromium --headed"
  },
  "lint-staged": {
    "backend/**/*.py": [
      "uv run --extra dev ruff check --fix",
      "uv run --extra dev ruff format"
    ],
    "scripts/**/*.py": [
      "uv run --extra dev ruff check --fix",
      "uv run --extra dev ruff format"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "npx --prefix frontend eslint --fix",
      "npx --prefix frontend prettier --write"
    ],
    "electron/src/**/*.ts": [
      "npx --prefix frontend prettier --write"
    ]
  },
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "electron": "^44.9.0",
    "electron-builder": "^26.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "typescript": "~6.0.3",
    "wait-on": "^9.5.1"
  }
}
