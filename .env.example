# Scene Atlas — environment variable reference
# Copy this file to .env and adjust for your environment.
# Pydantic-settings reads .env automatically; docker-compose.yml also
# interpolates these values via ${VAR:-default} syntax.

# ── Docker / deployment ─────────────────────────────────────────────────────
# Host port to expose the UI + API on (Docker only)
# PORT=8000
#
# Host path for the image library (Docker only — bind-mounted into container)
# IMAGE_DIR=./images

# ── CORS ────────────────────────────────────────────────────────────────────
# Origins allowed to reach the API. JSON array.
# For reverse-proxy setups, add your domain:
# CORS_ORIGINS=["https://maps.example.com"]
#
# Default (Docker):  ["http://localhost:8000"]
# Default (dev):     ["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ── Reverse proxy ───────────────────────────────────────────────────────────
# Proxies whose X-Forwarded-For is trusted for the client IP (rate limits).
# Comma-separated IPs/CIDRs. In Docker, use the proxy's address as seen from
# the container, e.g. the compose network gateway.
# FORWARDED_ALLOW_IPS=127.0.0.1,::1

# ── Storage roots ───────────────────────────────────────────────────────────
# APP_DATA_DIR=./data              # Database, vector index, thumbnails, logs
# IMAGE_LIBRARY_DIR=./images       # Original images and backups

# ── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL is auto-computed from APP_DATA_DIR. Override only if needed.
# DATABASE_URL=sqlite:///./data/battlemap.db

# ── Embedding model ─────────────────────────────────────────────────────────
# EMBEDDING_MODEL=                 # small/medium/large (auto-detected if unset)
# INFERENCE_DEVICE=auto            # auto/cpu/cuda/directml/coreml

# ── Debugging ───────────────────────────────────────────────────────────────
# DEBUG=false

# ── Storage format (initial seed value — managed in Settings afterward) ─────
# CONVERT_TO_WEBP=0               # 1 = store new imports as WebP

# ── Service constants (restart required) ────────────────────────────────────
# CLIP_TEXT_CACHE_MAX=256           # Max cached text embeddings (LRU)
# COLOR_CACHE_TTL_SECONDS=60       # Seconds before color index cache expires
# JOB_RETENTION_SECONDS=3600       # Seconds to keep completed job records
