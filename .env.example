# Scene Atlas — environment variable reference
# Copy this file to .env and adjust for your environment.
# Pydantic-settings reads .env automatically on startup.

# ── CORS ──────────────────────────────────────────────────────────────────────
# Allow the frontend dev server or a LAN client to reach the API.
# Accepts a JSON array so multiple origins are supported.
# Default (localhost only):
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
#
# LAN example (replace with your server's IP):
# CORS_ORIGINS=["http://192.168.1.100:5173"]

# ── Paths ─────────────────────────────────────────────────────────────────────
# DATA_DIR=./data
# STAGING_DIR=./data/staging

# ── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL=sqlite:///./data/battlemap.db

# ── Qdrant (embedded local mode) ─────────────────────────────────────────────
# QDRANT_PATH=./data/qdrant_local
# QDRANT_COLLECTION_NAME=battlemap_images

# ── CLIP model ────────────────────────────────────────────────────────────────
# CLIP_MODEL_NAME=laion/CLIP-ViT-B-32-laion2B-s34B-b79K
# CLIP_DEVICE=cpu   # set to "cuda" if a GPU is available

# ── Background jobs ──────────────────────────────────────────────────────────
# SCHEDULER_ENABLED=true     # Run periodic maintenance (backup, staging cleanup)

# ── Service constants ──────────────────────────────────────────────────────────
# Operator/developer tuning. Change requires restart. Not in AppSettings DB.
# CLIP_TEXT_CACHE_MAX=256           # Max cached text embeddings (LRU)
# COLOR_CACHE_TTL_SECONDS=60        # Seconds before color index cache expires
# JOB_RETENTION_SECONDS=3600        # Seconds to keep completed job records
