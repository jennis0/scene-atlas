# Scene Atlas — environment variable reference
# Copy this file to .env and adjust for your environment.
# Pydantic-settings reads .env automatically; docker-compose.yml also
# interpolates these values via ${VAR:-default} syntax.

# ── Docker / deployment ─────────────────────────────────────────────────────
# Host port to expose the UI + API on (Docker only)
# SCENE_ATLAS_PORT=8000
#
# Host path for the image library (Docker only — bind-mounted into container)
# SCENE_ATLAS_IMAGES_DIR=./images

# Docker only: the container runs as this user, which must be able to write
# SCENE_ATLAS_IMAGES_DIR. Match the directory's owner on the host (`id -u`, `id -g`).
# Set it before the first start: the data volume's files belong to this user.
# SCENE_ATLAS_UID=1000
# SCENE_ATLAS_GID=1000
#
# Docker only: the release to run (e.g. 0.2.0). Unset follows the latest release.
# SCENE_ATLAS_VERSION=

# ── CORS ────────────────────────────────────────────────────────────────────
# Origins allowed to reach the API. JSON array.
# For reverse-proxy setups, add your domain:
# SCENE_ATLAS_CORS_ORIGINS=["https://maps.example.com"]
#
# Default (Docker):  ["http://localhost:8000"]
# Default (dev):     ["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# ── Reverse proxy ───────────────────────────────────────────────────────────
# Proxies whose X-Forwarded-For is trusted for the client IP (rate limits).
# Comma-separated IPs/CIDRs. In Docker, use the proxy's address as seen from
# the container, e.g. the compose network gateway.
# SCENE_ATLAS_FORWARDED_ALLOW_IPS=127.0.0.1,::1

# ── Storage roots ───────────────────────────────────────────────────────────
# SCENE_ATLAS_DATA_DIR=./data              # Database (battlemap.db), vector index, thumbnails, logs
# SCENE_ATLAS_IMAGES_DIR=./images       # Original images and backups (default: SCENE_ATLAS_DATA_DIR/images if only SCENE_ATLAS_DATA_DIR is set)
# SCENE_ATLAS_LINKED_LIBRARY_DIR=              # Your own maps folder, read in place and never written to.
#                                  # Docker: set it in docker-compose.override.yml with a read-only mount (docs/deploy/server.md).

# ── Embedding model ─────────────────────────────────────────────────────────
# SCENE_ATLAS_EMBEDDING_MODEL=                 # small/medium/large (auto-detected if unset)
# SCENE_ATLAS_INFERENCE_DEVICE=auto            # auto/cpu/cuda/directml/coreml

# ── Updates (server mode) ───────────────────────────────────────────────────
# Once a day, ask GitHub whether a newer release is out and show it in Settings.
# false = no request is made.
# SCENE_ATLAS_CHECK_FOR_UPDATES=true

# ── Debugging ───────────────────────────────────────────────────────────────
# SCENE_ATLAS_DEBUG=false

# ── Storage format (initial seed value — managed in Settings afterward) ─────
# SCENE_ATLAS_CONVERT_TO_WEBP=0               # 1 = store new imports as WebP

# ── Service constants (restart required) ────────────────────────────────────
# SCENE_ATLAS_CLIP_TEXT_CACHE_MAX=256           # Max cached text embeddings (LRU)
# SCENE_ATLAS_JOB_RETENTION_SECONDS=3600       # Seconds to keep completed job records
