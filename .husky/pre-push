#!/bin/sh

# Pre-push hook: run the same checks CI runs to catch failures before they
# reach GitHub.  Skippable with `git push --no-verify` if needed.

echo "🔍 Running pre-push checks..."

# ── Backend ──────────────────────────────────────────────────────────────────

echo ""
echo "=== Python lint (ruff check) ==="
uv run ruff check backend/ scripts/ || {
  echo "❌ Python lint failed. Fix issues before pushing."
  exit 1
}

echo ""
echo "=== Python format check (ruff format) ==="
uv run ruff format --check backend/ scripts/ || {
  echo "❌ Python format check failed. Run: uv run ruff format backend/ scripts/"
  exit 1
}

echo ""
echo "=== Python type check (pyright) ==="
PYRIGHT_PYTHON_FORCE_VERSION=1.1.403 uvx pyright@1.1.403 || {
  echo "❌ Python type check failed."
  exit 1
}

echo ""
echo "=== Backend unit tests ==="
uv run python -m pytest backend/tests/unit/ -q || {
  echo "❌ Backend unit tests failed."
  exit 1
}

# ── Frontend ─────────────────────────────────────────────────────────────────

cd frontend

echo ""
echo "=== Frontend lint (ESLint) ==="
npx eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 || {
  echo "❌ Frontend lint failed."
  cd ..
  exit 1
}

echo ""
echo "=== Frontend format check (Prettier) ==="
npx prettier --check src/ || {
  echo "❌ Frontend format check failed. Run: cd frontend && npx prettier --write src/"
  cd ..
  exit 1
}

echo ""
echo "=== Frontend type check (tsc) ==="
npx tsc --noEmit || {
  echo "❌ Frontend type check failed."
  cd ..
  exit 1
}

echo ""
echo "=== Frontend dead code (knip) ==="
npm run --silent knip || {
  echo "❌ Unused files, exports or dependencies found."
  cd ..
  exit 1
}

echo ""
echo "=== Frontend tests (vitest) ==="
npx vitest run || {
  echo "❌ Frontend tests failed."
  cd ..
  exit 1
}

cd ..

echo ""
echo "=== Electron type check (tsc) ==="
npx tsc -p electron/tsconfig.json --noEmit || {
  echo "❌ Electron type check failed."
  exit 1
}

echo ""
echo "=== Electron unit tests (node --test) ==="
npm run --silent test:electron || {
  echo "❌ Electron unit tests failed."
  exit 1
}

echo ""
echo "=== Duplication (jscpd, threshold in .jscpd.json) ==="
npx --yes jscpd@4.0.5 --silent || {
  echo "❌ Copy-paste duplication is above the threshold. Run: npx jscpd@4.0.5"
  exit 1
}

echo ""
echo "✅ All pre-push checks passed!"

# ── Git LFS ─────────────────────────────────────────────────────────────────
command -v git-lfs >/dev/null 2>&1 && git lfs pre-push "$@"
