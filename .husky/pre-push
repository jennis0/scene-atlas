#!/bin/sh

# Pre-push hook: run the same checks CI runs to catch failures before they
# reach GitHub.  Skippable with `git push --no-verify` if needed.

echo "🔍 Running pre-push checks..."

# ── Backend ──────────────────────────────────────────────────────────────────

echo ""
echo "=== Backend lint (ruff check) ==="
uv run ruff check backend/ || {
  echo "❌ Backend lint failed. Fix issues before pushing."
  exit 1
}

echo ""
echo "=== Backend format check (ruff format) ==="
uv run ruff format --check backend/ || {
  echo "❌ Backend format check failed. Run: uv run ruff format backend/"
  exit 1
}

echo ""
echo "=== Backend unit tests ==="
uv run python -m pytest backend/tests/unit/ -q || {
  echo "❌ Backend unit tests failed."
  exit 1
}

# ── Frontend ─────────────────────────────────────────────────────────────────

cd frontend

echo ""
echo "=== Frontend lint (ESLint) ==="
npx eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0 || {
  echo "❌ Frontend lint failed."
  cd ..
  exit 1
}

echo ""
echo "=== Frontend format check (Prettier) ==="
npx prettier --check src/ || {
  echo "❌ Frontend format check failed. Run: cd frontend && npx prettier --write src/"
  cd ..
  exit 1
}

echo ""
echo "=== Frontend type check (tsc) ==="
npx tsc --noEmit || {
  echo "❌ Frontend type check failed."
  cd ..
  exit 1
}

echo ""
echo "=== Frontend tests (vitest) ==="
npx vitest run || {
  echo "❌ Frontend tests failed."
  cd ..
  exit 1
}

cd ..

echo ""
echo "✅ All pre-push checks passed!"
