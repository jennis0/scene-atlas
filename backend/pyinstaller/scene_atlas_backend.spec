# -*- mode: python ; coding: utf-8 -*-
#
# PyInstaller spec for the Scene Atlas backend sidecar.
#
# Build with:
#   uv run python scripts/build_sidecar.py
# or directly:
#   uv run pyinstaller backend/pyinstaller/scene_atlas_backend.spec
#
# Output: backend/pyinstaller/dist/scene-atlas-backend/
# The build_sidecar.py script copies this to the Electron extraResources path.
#
# ONNX models must be exported first:
#   uv run python scripts/export_clip_onnx.py

import sys
from pathlib import Path
from PyInstaller.utils.hooks import collect_all, collect_data_files, collect_dynamic_libs

# Project root (2 levels up from this spec file: backend/pyinstaller -> backend -> root)
project_root = Path(SPECPATH).parent.parent
sys.path.insert(0, str(project_root))

# ── tokenizers: lightweight Rust binary (used for CLIP text tokenization)
tokenizers_datas, tokenizers_binaries, tokenizers_hiddenimports = collect_all('tokenizers')

# ── onnxruntime: CLIP inference engine (replaces torch)
ort_datas    = collect_data_files('onnxruntime')
ort_binaries = collect_dynamic_libs('onnxruntime')

# ── ONNX model files (fp16 quantised — generated by scripts/export_clip_onnx.py)
# Vision + text encoder ONNX files go to _MEIPASS/models/
# Tokenizer vocab files go to _MEIPASS/models/tokenizer/
models_dir = project_root / 'backend' / 'models'
onnx_datas = [
    (str(models_dir / 'fp16' / 'clip_vision_encoder.onnx'), 'models'),
    (str(models_dir / 'fp16' / 'clip_text_encoder.onnx'),   'models'),
    (str(models_dir / 'tokenizer'),                          'models/tokenizer'),
]

a = Analysis(
    [str(project_root / 'backend' / 'pyinstaller' / 'entry.py')],
    pathex=[str(project_root)],
    binaries=tokenizers_binaries + ort_binaries,
    datas=tokenizers_datas + ort_datas + onnx_datas + [
        # Alembic migrations: alembic.ini + backend/alembic/ bundled into _MEIPASS root
        # database.py detects sys.frozen and reads from sys._MEIPASS instead of __file__
        (str(project_root / 'alembic.ini'),          '.'),
        (str(project_root / 'backend' / 'alembic'),  'backend/alembic'),
    ],
    hiddenimports=[
        # uvicorn internals
        'uvicorn',
        'uvicorn.logging',
        'uvicorn.loops',
        'uvicorn.loops.auto',
        'uvicorn.protocols',
        'uvicorn.protocols.http',
        'uvicorn.protocols.http.auto',
        'uvicorn.protocols.websockets',
        'uvicorn.protocols.websockets.auto',
        'uvicorn.lifespan',
        'uvicorn.lifespan.on',
        # FastAPI / Starlette
        'fastapi',
        'starlette',
        'starlette.middleware',
        'starlette.middleware.cors',
        # SQLAlchemy dialects
        'sqlalchemy.dialects.sqlite',
        'sqlalchemy.dialects.sqlite.pysqlite',
        # Alembic
        'alembic',
        'alembic.config',
        # Pydantic
        'pydantic',
        'pydantic_settings',
        'pydantic_core',
        # Multipart / file uploads
        'multipart',
        'python_multipart',
        # aiofiles
        'aiofiles',
        'aiofiles.os',
        'aiofiles.threadpool',
        # Qdrant client (embedded mode) — grpc is imported unconditionally at module load
        'qdrant_client',
        'qdrant_client.local',
        'qdrant_client.local.local_collection',
        'grpc',
        'grpc._cython',
        'grpc._cython.cygrpc',
        # OpenCV (headless)
        'cv2',
        # scikit-learn
        'sklearn',
        'sklearn.utils._cython_blas',
        'sklearn.neighbors._partition_nodes',
        'sklearn.tree._utils',
        # scipy (full package collected — sklearn has transitive deps throughout)
        'scipy',
        'scipy.special._ufuncs_cxx',
        'scipy.linalg.cython_blas',
        'scipy.linalg.cython_lapack',
        # ONNX Runtime (CLIP inference)
        'onnxruntime',
        'onnxruntime.capi',
        # Tokenizers (CLIP text tokenization)
        'tokenizers',
        # Misc
        'numpy',
        'PIL',
        'PIL.Image',
        'yaml',
    ] + tokenizers_hiddenimports,
    excludes=[
        # GUI toolkits — not needed server-side
        'tkinter',
        '_tkinter',
        'wx',
        'PyQt5',
        'PyQt6',
        # Dev/test tools
        'pytest',
        'pytest_asyncio',
        'ruff',
        'ipywidgets',
        'matplotlib',
        'notebook',
        'jupyter',
        'ipython',
        'jedi',           # IDE code completion — not needed at runtime
        # torch/transformers — replaced by onnxruntime (exclude in case of transitive deps)
        'torch',
        'transformers',
        'triton',         # GPU JIT compiler
        # Unused database drivers (project uses SQLite, not PostgreSQL)
        'asyncpg',
        # Note: grpc/grpcio intentionally NOT excluded — qdrant_client imports grpc
        # unconditionally at module load (via async_qdrant_client → qdrant_client.grpc),
        # even when using local embedded mode only.
        # HuggingFace download accelerator — not needed in frozen sidecar
        'hf_xet',
        # Prefect (removed — exclude in case of transitive dependency)
        'prefect',
    ],
    win_no_prefer_redirects=False,
    win_private_assemblies=False,
    noarchive=False,
)

# ── Post-analysis cleanup ─────────────────────────────────────────────────────
# Remove directories and files that hooks collect but are never needed at runtime.
import re as _re

_JUNK_PREFIXES = (
    # scipy submodules intentionally NOT excluded — sklearn has transitive deps
    # throughout scipy (sparse, spatial, stats, optimize, etc.) so we let
    # PyInstaller collect the full scipy package.
)

# .dist-info directories are package metadata — safe to strip at runtime.
# IMPORTANT: Some packages use entry_points.txt in .dist-info for plugin
# discovery (e.g. onnxruntime execution providers).  CPUExecutionProvider is
# statically compiled into onnxruntime and requires no entry-points lookup,
# so stripping .dist-info is safe for the current provider list.  If GPU or
# other plugin-based providers are ever added, revisit this filter.
_DIST_INFO_RE = _re.compile(r'\.dist-info/')

def _keep_entry(entry):
    name = entry[0].replace('\\', '/')
    if _DIST_INFO_RE.search(name):
        return False
    for prefix in _JUNK_PREFIXES:
        if name.startswith(prefix) or f'/{prefix}' in name:
            return False
    return True

a.binaries = TOC([e for e in a.binaries if _keep_entry(e)])
a.datas    = TOC([e for e in a.datas    if _keep_entry(e)])
# ─────────────────────────────────────────────────────────────────────────────

pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name='scene-atlas-backend',
    debug=False,
    bootloader_ignore_signals=False,
    strip=True,         # Strip debug symbols from binaries
    upx=True,           # UPX-compress binaries
    console=True,       # Must be True: stdout is how we signal SCENE_ATLAS_READY
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
)

# Note: a.zipfiles was removed in PyInstaller 6 — do not pass it to COLLECT
coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=True,         # Strip debug symbols — matches EXE setting above
    upx=True,
    upx_exclude=[
        # OpenCV — monolithic .so with complex symbol resolution
        'cv2.abi3.so',
    ],
    name='scene-atlas-backend',
)
