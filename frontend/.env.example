# Scene Atlas — frontend environment variables
# Copy to .env and adjust for your deployment.
# Vite bakes these values into the JS bundle at build time.

# ── Authentication (server mode) ──────────────────────────────────────────────
# Must match the backend AUTH_TOKEN setting exactly.
# Leave unset for Electron or local dev (no auth required).
# Generate a token: uv run python -m backend.scripts.generate_token
# VITE_AUTH_TOKEN=your-secret-token-here
